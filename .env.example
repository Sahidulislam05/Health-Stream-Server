NODE_ENV=development
PORT=5000
# Day rules use Bangladesh time in code; TZ only affects local logs (Vercel reserves TZ).
TZ=Asia/Dhaka
# Proxies in front of the API (Vercel + frontend rewrite). Check req.ip on a preview before changing.
TRUST_PROXY=1

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ph_healthcare?schema=public"

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=testeradmin@example.com
TESTER_ADMIN_PASSWORD=replace-with-a-strong-password

TESTER_DOCTOR_NAME=Tester Doctor
TESTER_DOCTOR_EMAIL=testerdoctor@example.com
TESTER_DOCTOR_PASSWORD=replace-with-a-strong-password

REDIS_USER=default
REDIS_PASSWORD=replace-with-your-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_USER=your-smtp-user
EMAIL_SENDER=your-email-sender
SMTP_PASSWORD=replace-with-your-smtp-password

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_CALLBACK_URL=http://localhost:5000/api/v1

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/v1/cron/daily
CRON_SECRET=replace-with-a-random-string-of-16-plus-characters
# Same value as the frontend's REVALIDATE_SECRET; lets the API refresh cached doctor pages
REVALIDATE_SECRET=replace-with-another-random-string

# Demo accounts (shared, reset nightly). Use inboxes you control: bookings send real email.
DEMO_MODE=false
DEMO_PATIENT_EMAIL=
DEMO_DOCTOR_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_APPLICANT_EMAIL=
